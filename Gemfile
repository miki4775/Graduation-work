source 'https://rubygems.org'

# Railsのバージョンを指定
gem 'rails', '~> 6.1.7'

# PostgreSQL用のgem
gem 'pg', '>= 0.18', '< 2.0'

# ユーザー認証にDeviseを使う場合
gem 'devise'

# テストにRSpecを使う場合
gem 'rspec-rails'

# フロントエンドにWebpackerを使う場合
gem 'webpacker'

# activesupport のバージョンを Rails と一致させる
gem 'activesupport', '~> 6.1.7'
